# Copy to .env only for local tooling that loads dotenv, or export these values.
SCANN_ENV=development
SCANN_SECRET_KEY=replace-with-at-least-32-random-characters
SCANN_ADMIN_USERNAME=admin
SCANN_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

SCANN_HOST=127.0.0.1
SCANN_PORT=5000
SCANN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

SCANN_DEMO_N_CELLS=2000
SCANN_DEMO_DIM=50
SCANN_DEFAULT_INDEX=flat
SCANN_DEFAULT_METRIC=l2
SCANN_MAX_TOP_K=1000
SCANN_MAX_EVAL_QUERIES=1000
SCANN_MAX_VISUALIZATION_POINTS=3000
SCANN_MAX_FEDERATED_DATASETS=10
SCANN_MAX_FEDERATED_CELLS=1000000
SCANN_MAX_ASSISTANT_CELLS=100000
SCANN_MAX_ASSISTANT_EVIDENCE=20
SCANN_MAX_ASSISTANT_QUESTION_CHARS=2000
SCANN_MAX_UPLOAD_BYTES=536870912

# Optional grounded AI generation. Leave both unset to use local evidence summaries.
# OPENAI_API_KEY=replace-with-a-project-api-key
# SCANN_OPENAI_MODEL=gpt-5.6-luna
SCANN_OPENAI_BASE_URL=https://api.openai.com/v1
SCANN_OPENAI_TIMEOUT_SECONDS=30
SCANN_OPENAI_MAX_OUTPUT_TOKENS=800

SCANN_LOG_TO_FILE=true
SCANN_LOG_LEVEL=INFO
SCANN_DEBUG=false
SCANN_NUMBA_NUM_THREADS=1
# SCANN_NUMBA_CACHE_DIR=.cache/numba
